{
  "name": "tiny-kendo",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.ts",
    "dev:online": "NEXT_PUBLIC_TINY_KENDO_SERVER=/ws node --env-file-if-exists=.env server/index.ts",
    "test": "node --test \"game/**/*.test.ts\" \"server/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
